# Token from @BotFather
BOT_TOKEN=123456789:AA...

# Your Telegram user id (get it from @userinfobot). Several: 111,222
ADMIN_IDS=

# Where the SQLite database lives
DB_PATH=data/bot.db

# Exchange rate used to compare AMD and USD prices — update it now and then
AMD_PER_USD=390

# Reports from different users before a phone number is blacklisted
REPORT_LIMIT=3

# Max listings one user can post in 24 hours
DAILY_POST_LIMIT=5

# Mini App. Railway sets PORT and RAILWAY_PUBLIC_DOMAIN by itself once you generate a domain,
# so on Railway leave these empty. Elsewhere: the port to listen on and the public https URL.
PORT=
WEBAPP_URL=

# Optional: only read posts from these channel ids (e.g. -1001234567890). Empty = any channel where the bot is admin
ALLOWED_CHANNELS=
